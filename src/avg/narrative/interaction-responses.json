{
  "SCENE.duty.bulletin": {
    "first": {
      "text": "墙上的守则写得一本正经的。……其实就两句话：{warm}灯别全关，{/warm}{heavy}人别全丢。{/heavy}",
      "face": 9,
      "motion": "blink",
      "pose": "point"
    },
    "variants": [
      {
        "when": {
          "minKeys": 3
        },
        "speech": {
          "text": "守则最后一条被铅笔涂黑了对吧？……{pause:0.6s}{shake}别看被划掉的那一行，{/shake}{warm}看前面两行就行。{/warm}",
          "face": 9,
          "motion": "blink",
          "pose": "point"
        }
      }
    ],
    "repeat": {
      "text": "守则还在墙上。忘了就再看一眼，不收补考费。",
      "face": 9,
      "motion": "blink",
      "pose": "paper"
    }
  },
  "SCENE.corridor.phone-hang": {
    "first": {
      "text": "挂上就好。老铁钩子有点松，{wave}免得老听筒受潮短路了。{/wave}",
      "face": 9,
      "motion": "blink",
      "pose": "relief"
    },
    "repeat": {
      "text": "挂断了？线路那头空荡荡的，{cold}还是这走廊的雨声更实在点。{/cold}",
      "face": 9,
      "motion": "blink",
      "pose": "relief"
    }
  },
  "CONTROL.archive-exit": {
    "first": {
      "text": "先回桌边吧。{warm}读过的纸页放回原格，下次才找得到。{/warm}",
      "face": 9,
      "motion": "blink",
      "pose": "paper"
    },
    "variants": [
      {
        "when": {
          "fact": "unreturned"
        },
        "speech": {
          "text": "刚看的那份档案还没放回原格呢。……{pause:0.5s}{wave}不放也行，反正我不给你记违纪分。{/wave}",
          "face": 9,
          "motion": "blink",
          "pose": "paper"
        }
      },
      {
        "when": {
          "fact": "unread"
        },
        "speech": {
          "text": "那份档案还没翻开。想看时再来取，不急。",
          "face": 9,
          "motion": "blink",
          "pose": "paper"
        }
      }
    ],
    "repeat": {
      "text": "档案柜就在这儿，想看再来。读完记得亲手归还。",
      "face": 9,
      "motion": "blink",
      "pose": "paper"
    }
  },
  "CONTROL.music-open": {
    "first": {
      "text": "想放哪首滚筒随便挑。{wave}右边的发条要是松了，顺手帮我拧一下。{/wave}",
      "face": 9,
      "motion": "blink",
      "pose": "care"
    },
    "variants": [
      {
        "when": {
          "minKeys": 3
        },
        "speech": {
          "text": "放首慢歌吧。……{pause:0.8s}{cold}这会儿听点叮咚响的，{/cold}{warm}省得我老胡思乱想。{/warm}",
          "face": 9,
          "motion": "blink",
          "pose": "care"
        }
      }
    ],
    "repeat": {
      "text": "滚筒还在里面。挑吧，我听着。",
      "face": 9,
      "motion": "blink",
      "pose": "listen"
    },
    "cooldownMs": 20000
  }
}
